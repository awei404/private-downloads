# BWI TMS monitor - Windows production settings. install.ps1 copies this to .env (only if .env does not exist).
# Credentials are NOT here: put them in the secrets folder (see README-Windows.md).
GOFO_TAG=unauthorized
GOFO_AUTH_FILE=secrets/gofo_auth
FEISHU_WEBHOOK_FILE=secrets/feishu_webhook

BWI_DB_PATH=data/bwi_monitor.db
BWI_LOG_DIR=data/logs
BWI_POLL_SECONDS=600

# Dashboard for the warehouse network: http://<this computer's IP>:8766
BWI_WEB_HOST=0.0.0.0
BWI_WEB_PORT=8766
BWI_DASHBOARD_FILE=dashboard_v2.html
# Required for Start/End Shift and closing alerts from other computers. Change it.
BWI_ADMIN_TOKEN=change-me

# Feishu. Keep TEST_MODE=true for the first trial day (messages recorded, not sent), then set it to false.
FEISHU_ENABLED=true
FEISHU_TEST_MODE=true
FEISHU_DEPARTURE_ENABLED=true
