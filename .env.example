# Copy to .env and adjust. Credentials go in secrets/ (chmod 600), never in this file or in git.
#   secrets/gofo_auth        TMS Authorization value ("Bearer ...")
#   secrets/feishu_webhook   Feishu custom-bot webhook URL (generate a NEW one; the earlier one was exposed)
#   secrets/feishu_secret    optional: the bot's signing secret, if signature verification is on
GOFO_TAG=unauthorized
BWI_POLL_SECONDS=600

# Dashboard. Production on the BWI computer: listen on the local network and require a token for shift buttons.
BWI_WEB_HOST=0.0.0.0
BWI_WEB_PORT=8765
BWI_ADMIN_TOKEN=change-me

# Rules
BWI_UNLOAD_WARN_MINUTES=30,5
BWI_WARN_MINUTES=30,15
BWI_OP_GRACE_MINUTES=30
BWI_DAY_BOUNDARY=05:00
BWI_SHIFT_REMINDER_TIME=08:15

# Feishu: keep test mode on until one controlled test message (python3 -m bwi_monitor --feishu-test) succeeds
FEISHU_ENABLED=false
FEISHU_TEST_MODE=true
FEISHU_INCLUDE_DEPARTURE=false
FEISHU_MAX_PER_TICK=5
