# BWI TMS monitor - Mac settings. install.sh copies this to .env (only if .env does not exist).
# Credentials are NOT here: put them in the secrets folder (the installer asks for them; see README-Mac.md).
GOFO_TAG=unauthorized
GOFO_AUTH_FILE=secrets/gofo_auth
FEISHU_WEBHOOK_FILE=secrets/feishu_webhook

BWI_DB_PATH=data/bwi_monitor.db
BWI_LOG_DIR=data/logs
BWI_POLL_SECONDS=600

# Dashboard on this Mac only. Set 0.0.0.0 to open it from other computers on the network.
BWI_WEB_HOST=127.0.0.1
BWI_WEB_PORT=8766
BWI_DASHBOARD_FILE=dashboard_v2.html
# Required for Start/End Shift and closing alerts from other computers. Change it.
BWI_ADMIN_TOKEN=change-me

# Feishu. Starts in test mode (messages recorded, not sent). To go live, click the Feishu chip at the top of the
# dashboard (admin password) - no need to edit this file. Live sending also needs an open shift (Start Shift).
FEISHU_ENABLED=true
FEISHU_TEST_MODE=true
FEISHU_DEPARTURE_ENABLED=true
